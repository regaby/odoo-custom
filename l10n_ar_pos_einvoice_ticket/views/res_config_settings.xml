<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form_einvoice_ticket" model="ir.ui.view">
            <field name="name">res.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@id='pos_interface_section']" position="after">
                    <block title="POS einvoice Ticket" id="einvoice_ticket">
                        <setting id="pos_auto_invoice" string="POS auto invoice" >
                            <field name="pos_auto_invoice"/>
                        </setting>
                        <setting id="pos_receipt_invoice_number" >
                            <field name="pos_receipt_invoice_number"/>
                        </setting>
                        <setting id="pos_receipt_customer_vat" >
                            <field name="pos_receipt_customer_vat"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
