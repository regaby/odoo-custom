<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='props.data.company.partner_id?.[1]']" position="before">
            <div style="text-align: center;"><t t-esc="props.data.pos_name" /></div>
            <div style="margin-bottom:0.4rem;text-align: center;"><t t-esc="props.data.pos_street" /></div>
        </xpath>
        <xpath expr="//t[@t-if='props.data.company.vat']" position="after">
            <div>Ing. Brutos: <t t-esc="this.env.services.pos.company.l10n_ar_gross_income_number"/></div>
            <div>Inicio de actividadess: <t t-esc="this.env.services.pos.company.l10n_ar_afip_start_date"/></div>
            <div><t t-esc="this.env.services.pos.company.l10n_ar_afip_responsibility_type_id[1]"/></div>
                <div>Dirección: <t t-esc="this.env.services.pos.company.street"/>
                <t t-if="this.env.services.pos.company.city">
                    , <t t-esc="this.env.services.pos.company.city"/>
                </t>
                <t t-if="this.env.services.pos.company.state_id">
                    , <t t-esc="this.env.services.pos.company.state_id[1]"/>
                </t>
                <t t-if="this.env.services.pos.company.country_id">
                    , <t t-esc="this.env.services.pos.company.country_id[1]"/>
                </t>
                </div>
        </xpath>
        <xpath expr="//div[hasclass('cashier')]" position="replace">
            <t t-if='props.data.invoice_number and props.data.receipt_invoice_number'>
                <div class="afip-invoice-info" >
                    <hr />
                    <strong>
                    <t t-esc="props.data.l10n_latam_document_name"/> - ORIGINAL
                        <t t-if="props.data.invoice_letter == 'A'">
                            - COD (<t t-esc="props.data.l10n_latam_document_type_id"/>)
                        </t>
                        <br />
                    N° DE FACTURA: <t t-esc="props.data.invoice_number"/><br />
                    FECHA: <t t-esc="props.data.date"/>
                    </strong>
                    <br />
                </div>
            </t>
            <t t-if="this.env.services.pos.get_order().partner">
                <hr />
                <div> CLIENTE: <t t-esc="this.env.services.pos.get_order().partner.name"/></div>
                <t t-if='props.data.invoice_number'>
                    <!-- si el tipo de doc. es Sigd no lo muestro -->
                    <t t-if="this.env.services.pos.get_order().partner.l10n_latam_identification_type_id[0] != 7">
                        <t t-esc='this.env.services.pos.get_order().partner.l10n_latam_identification_type_id[1]' />:
                    </t>
                    <t t-if="this.env.services.pos.get_order().partner.vat">
                        <t t-esc='this.env.services.pos.get_order().partner.vat' />
                    </t>
                    <t t-if="this.env.services.pos.get_order().partner.l10n_ar_afip_responsibility_type_id">
                        <div><t t-esc='this.env.services.pos.get_order().partner.l10n_ar_afip_responsibility_type_id[1]' /></div>
                    </t>
                </t>
                <t t-if="this.env.services.pos.get_order().partner.street">
                    <div>
                        CALLE: <t t-esc="this.env.services.pos.get_order().partner.street"/>
                        <t t-if="this.env.services.pos.get_order().partner.city">
                            , <t t-esc="this.env.services.pos.get_order().partner.city"/>
                        </t>
                        <t t-if="this.env.services.pos.get_order().partner.state_id">
                            , <t t-esc="this.env.services.pos.get_order().partner.state_id[1]"/>
                        </t>
                        <t t-if="this.env.services.pos.get_order().partner.country_id">
                            , <t t-esc="this.env.services.pos.get_order().partner.country_id[1]"/>
                        </t>
                    </div>
                    <t t-if="this.env.services.pos.get_order().partner.email">
                        <div>Email: <t t-esc="this.env.services.pos.get_order().partner.email"/></div>
                    </t>
                    <t t-if="this.env.services.pos.get_order().partner.phone or this.env.services.pos.get_order().partner.mobile">
                        <div>Tel: <t t-esc="this.env.services.pos.get_order().partner.phone || this.env.services.pos.get_order().partner.mobile"/></div>
                    </t>
                    <t t-if="this.env.services.pos.get_order().partner.website">
                        <div>Website: <t t-esc="this.env.services.pos.get_order().partner.website"/></div>
                    </t>
                </t>
            </t>
            <div t-if="props.data.cashier" class="cashier">
                <hr />
                <div>Cajero: <t t-esc="props.data.cashier" /></div>
            </div>
        </xpath>
    </t>

    <t t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        <xpath expr="//div[@class='before-footer']" position="after">
            <t t-if="props.data.afip_auth_code and props.data.receipt_invoice_number">
                <div class="afip-cae-info"  style="text-align: center; font-size: 75%; margin-top:20px;">
                    <t t-if="props.data.texto_modificado_qr">
                        <div style="overflow: hidden;">
                            <img t-attf-src="/report/barcode/?barcode_type={{'QR'}}&amp;value={{props.data.texto_modificado_qr}}&amp;width={{180}}&amp;height={{180}}" style="width:180px;height:180px" />
                        </div>
                    </t>
                    <strong>CAE:</strong> <t t-esc="props.data.afip_auth_code"/>
                    <div style="margin-top:3px;">
                        <strong>Vto. CAE:</strong> <t t-esc="props.data.afip_auth_code_due"/>
                    </div>
                </div>
            </t>
        </xpath>
        <xpath expr="//div[@class='pos-receipt-taxes']" position="replace">
            <div t-if="props.data.tax_details.length > 0 and props.data.invoice_letter == 'A'" class="pos-receipt-taxes">
                <span />
                <span>VAT</span>
                <span>ExVAT</span>
                <span>Total</span>
                <span />
                <t t-foreach="props.data.tax_details" t-as="tax" t-key="tax.tax.id">
                    <span />
                    <span><t t-esc="tax.tax.amount"/>%</span>
                    <span t-esc="props.formatCurrency(tax.base, false)" />
                    <span t-esc="props.formatCurrency(tax.amount + tax.base, false)" />
                    <span />
                </t>
                <t t-if="props.data.tax_details.length > 1">
                    <span />
                    <span t-esc="props.formatCurrency(props.data.amount_tax, false)" />
                    <span t-esc="props.formatCurrency(props.data.total_without_tax, false)" />
                    <span t-esc="props.formatCurrency(props.data.amount_total, false)" />
                    <span />
                </t>
            </div>
        </xpath>
    </t>

</templates>
